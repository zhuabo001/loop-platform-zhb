{
  "name": "@loopzhb/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loop-platform-zhb control plane: scheduling, state, auth, storage. Currently the db module only (Phase 1 Day 1-2: heart schema) — the HTTP layer lands with poll/report in Day 3-4. See docs/adr/003-heart-schema.md.",
  "exports": {
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./db/schema": {
      "types": "./dist/db/schema.d.ts",
      "import": "./dist/db/schema.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @loopzhb/protocol build && tsc --noEmit",
    "test": "pnpm --filter @loopzhb/protocol build && vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit generate && git diff --exit-code -- drizzle/"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@hono/node-server": "^2.0.12",
    "@loopzhb/protocol": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
