{
  "name": "@loopzhb/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single source of truth for the loop-platform-zhb server/daemon wire protocol: DTO schemas (zod), enums, token shapes. See docs/adr/002-protocol-package.md.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
